# Copy to /etc/researchlens/backend.env, owned root:root, mode 0600.
# systemd reads this file; never commit the populated copy.
OPENAI_API_KEY=
RESEARCHLENS_REQUIRE_AUTH=true
RESEARCHLENS_API_TOKEN=
RESEARCHLENS_BUDGET_PATH=/var/lib/researchlens/demo-budget.json
RESEARCHLENS_MAX_QUESTIONS=100
RESEARCHLENS_ASK_PER_MINUTE=5
RESEARCHLENS_FEEDBACK_PER_MINUTE=20
RESEARCHLENS_FEEDBACK_PATH=/var/lib/researchlens/feedback.jsonl
RESEARCHLENS_DEBUG_CITATIONS=false
# Server-to-server HTTP does not require browser CORS origins.
RESEARCHLENS_CORS_ORIGINS=
