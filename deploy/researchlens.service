[Unit]
Description=ResearchLens single-worker API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=researchlens
Group=researchlens
WorkingDirectory=/srv/ResearchLens
EnvironmentFile=/etc/researchlens/backend.env
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=OMP_NUM_THREADS=2
Environment=MKL_NUM_THREADS=2
Environment=TOKENIZERS_PARALLELISM=false
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/ResearchLens/.venv/bin/python -m uvicorn app.api:app --host 127.0.0.1 --port 8000 --workers 1 --timeout-graceful-shutdown 400 --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=410
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/researchlens

[Install]
WantedBy=multi-user.target
